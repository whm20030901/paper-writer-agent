APP_NAME=paper-writer-agent
APP_ENV=prod
APP_HOST=0.0.0.0
APP_PORT=8000
MEMORY_DB_PATH=memory.db
RUN_DB_PATH=runs.db
API_KEY=
RATE_LIMIT_PER_MINUTE=60
RUN_RETENTION_DAYS=30
AUTO_PURGE_ON_STARTUP=false
DEFAULT_ITERATIONS=2
PROMPT_VERSION=v1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=1
LLM_RETRY_BACKOFF_S=0.2
LLM_RETRY_JITTER_S=0.0
LLM_RETRY_MAX_DELAY_S=30.0
LLM_RETRY_BACKOFF_MULTIPLIER=2.0
SLO_MIN_SUCCESS_RATE=0.9
SLO_MIN_AVG_QUALITY_SCORE=7.0
SLO_MAX_AVG_DURATION_MS=5000
SLO_ALERT_CHANNELS=log,webhook
SLO_ALERT_WEBHOOK_URL=
SLO_ALERT_COOLDOWN_SECONDS=300
SLO_ALERT_DEDUPE_WINDOW_SECONDS=900
SLO_ALERT_WEBHOOK_TIMEOUT_S=3.0
SLO_ALERT_ROUTE_OVERRIDES=quality=log;latency=webhook
SLO_ALERT_TEMPLATE=[{status}] violations={violations} fingerprint={fingerprint}
SLO_ALERT_POLICY_VERSION=v1
SLO_ALERT_AUTO_ARCHIVE_ON_STARTUP=false
SLO_ALERT_AUTO_ARCHIVE_DAYS=30
SLO_SLA_MAX_OPEN_DEGRADED_ALERTS=5
SLO_ALERT_AUTO_TUNE_ENABLED=true
SLO_ALERT_REGRESSION_GUARDRAIL_MIN_DELTA=-3.0
SLO_ALERT_CANARY_ENABLED=true
SLO_ALERT_CANARY_PROMOTION_THRESHOLD=0.75
RELEASE_GATE_MIN_SCORE=80.0
RELEASE_GATE_REQUIRE_NO_ROLLBACK=true
RELEASE_WEBHOOK_SECRET=
ACCEPTANCE_GATE_MAX_FAILED_CHECKS=0
ROLLOUT_AUTO_ROLLBACK_ENABLED=true
OPERATIONS_AUDIT_MIN_GRADE=B
RELEASE_APPROVAL_REQUIRED=true
RELEASE_APPROVAL_SYNC_URL=
RELEASE_APPROVAL_SYNC_TIMEOUT_S=3.0
AUDIT_REPORT_HISTORY_LIMIT=200
AUDIT_TREND_NOTIFY_WEBHOOK_URL=
AUDIT_TREND_NOTIFY_TIMEOUT_S=3.0
